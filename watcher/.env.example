# Copy this to .env and fill in VENDING_WALLET_ADDRESS at minimum.

# Base Sepolia — zero-value testnet only. There is no mainnet path in this repo.
RPC_URL=https://sepolia.base.org

# Circle's official Base Sepolia USDC. Leave this unless you have a reason to change it.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# REQUIRED — the wallet this vending machine "owns". Payments are watched
# TO this address. Use a fresh wallet you hold the key to, not a shared one.
VENDING_WALLET_ADDRESS=

# Price per item, in USDC (not base units — the watcher converts this).
PRICE_USDC=0.01

# How often to poll the chain, in ms.
POLL_INTERVAL_MS=5000

# HTTP port for the kiosk page + queue API.
PORT=8787

# ---- plotter (the writing machine) ----

# Font fallback chain, comma-separated. Per phrase, the font covering the
# most characters wins — Korean (Nanum Pen) and Chinese (Ma Shan Zheng)
# handwriting faces ship in fonts/, both SIL OFL.
FONT_PATH=./fonts/NanumPenScript-Regular.ttf,./fonts/MaShanZheng-Regular.ttf

# USB serial device of the GRBL board. On macOS: ls /dev/cu.* — e.g.
# /dev/cu.usbserial-10. Takes priority over PLOTTER_TCP when both are set.
# IMPORTANT: close any `screen` session on this port first; two programs
# cannot hold the same serial device.
PLOTTER_SERIAL=

# WiFi alternative: "host:port" of the board's telnet G-code endpoint.
PLOTTER_TCP=

# Leave both empty for dry-run mode (G-code written to DRY_RUN_DIR).

# Work area in mm, WIDTHxHEIGHT. Measure your machine's real travel.
WORK_AREA_MM=60x60

# Drawing / travel speeds in mm/min. Lower FEED_DRAW if strokes come out
# wobbly or distorted — small steppers lose steps at high speed.
FEED_DRAW=600
FEED_TRAVEL=1500

# Pen servo commands — THE per-machine binding. Find yours by trying
# M3 S1000 / M5 / G0 Z5 in a serial console and watching the servo.
PEN_UP_CMD=M5
PEN_DOWN_CMD=M3 S1000
