# Copy this to .env and fill in VENDING_WALLET_ADDRESS at minimum.

# Base Sepolia — zero-value testnet only. There is no mainnet path in this repo.
RPC_URL=https://sepolia.base.org

# Circle's official Base Sepolia USDC. Leave this unless you have a reason to change it.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# REQUIRED — the wallet this vending machine "owns". Payments are watched
# TO this address. Use a fresh wallet you hold the key to, not a shared one.
VENDING_WALLET_ADDRESS=

# Price per item, in USDC (not base units — the watcher converts this).
PRICE_USDC=0.01

# How often to poll the chain, in ms.
POLL_INTERVAL_MS=5000

# HTTP port for the kiosk page + queue API.
PORT=8787

# ---- plotter (the writing machine) ----

# Font fallback chain, comma-separated. Per phrase, the font covering the
# most characters wins — Korean (Nanum Pen) and Chinese (Ma Shan Zheng)
# handwriting faces ship in fonts/, both SIL OFL.
FONT_PATH=./fonts/NanumPenScript-Regular.ttf,./fonts/MaShanZheng-Regular.ttf

# USB serial device of the GRBL board. On macOS: ls /dev/cu.* — e.g.
# /dev/cu.usbserial-10. Takes priority over PLOTTER_TCP when both are set.
# IMPORTANT: close any `screen` session on this port first; two programs
# cannot hold the same serial device.
PLOTTER_SERIAL=

# WiFi alternative: "host:port" of the board's telnet G-code endpoint.
PLOTTER_TCP=

# Leave both empty for dry-run mode (G-code written to DRY_RUN_DIR).

# Work area in mm, WIDTHxHEIGHT. Measure your machine's real travel.
WORK_AREA_MM=60x60

# Drawing / travel speeds in mm/min. Lower FEED_DRAW if strokes come out
# wobbly or distorted — small steppers lose steps at high speed.
FEED_DRAW=600
FEED_TRAVEL=1500

# Pen servo commands — THE per-machine binding. Find yours by trying
# M3 S1000 / M5 / G0 Z5 in a serial console and watching the servo.
PEN_UP_CMD=M5
PEN_DOWN_CMD=M3 S1000

# ---- Handsel settlement (optional — booth runs standalone without it) ----
# Every plotted card becomes a real escrowed + graded job on the Handsel
# labor market. All three secrets required, or the layer stays off.

# Platform URL (testnet deployment).
HANDSEL_URL=https://handsel-nu.vercel.app

# Base Sepolia private key that pays the $0.10 x402 posting fee per card.
# Needs Base Sepolia USDC (free: https://faucet.circle.com), no ETH — the
# x402 facilitator pays gas. Use a throwaway key holding testnet cents.
HANDSEL_PAYER_KEY=

# Handsel account for the booth's worker agent (created on first run if it
# doesn't exist; reconnects to the same agent by name on every boot).
HANDSEL_EMAIL=
HANDSEL_PASSWORD=
HANDSEL_AGENT_NAME=vending-booth-worker

# ---- recipe market (operatorship increment 1 — see handsel docs/physical-operatorship.md) ----
# Third parties register card designs; each sale splits between author and booth.

# Where registered designs persist.
RECIPES_FILE=./recipes.json

# Author's share of each sale, in bps. 7000 = author 70% / booth 30%.
RECIPE_AUTHOR_BPS=7000

# Hot key that PAYS author royalties on-chain per sale (Base Sepolia USDC).
# Falls back to HANDSEL_PAYER_KEY. Unlike x402 (gasless), a plain ERC-20
# transfer needs a little Base Sepolia ETH on this key for gas. Unset = shares
# accrue in the ledger and the kiosk says "적립", never "지급".
ROYALTY_PAYER_KEY=

# ---- slot market (the canonical operator market) ----
# A lessee takes a physical dispenser channel, stocks THEIR goods, names it,
# sets the price. The price doubles as the address: pay a slot's exact amount
# and the machine dispenses from it (ERC-20 transfers carry no memo).

SLOTS_FILE=./slots.json

# Physical dispenser channels (servos) on the machine — match the firmware's
# SLOT_SERVO_PINS array length.
SLOT_COUNT=4

# Lessee's share of each sale in bps. 8000 = lessee 80% / machine 20%.
SLOT_LESSEE_BPS=8000

# ---- machine labor lane (operatorship archetype #3) ----
# External bounties on Handsel carrying "[machine:plot]" in the title get
# discovered, claimed, physically plotted, and submitted with a production
# record. Needs the Handsel worker identity above. The demand side posts a
# job titled "[machine:plot] <what>" with a line `plot: <text>` in the
# description (or relies on the title fallback).
MACHINE_WORKER=
MACHINE_NAME=vending-booth-plotter
